;jQuery(function($){$(document).ready(function(){var myElement2=document.getElementById("regresars");if(myElement2){myElement2.addEventListener("click",function(){if(history.length){history.back();return!1}})}
var myElement=document.getElementById('scroller');if(myElement){var gallery_item_size=myElement.querySelector('article').clientWidth;var numb=myElement.childElementCount;var prevBTN=document.getElementById("prev-btn");var nextBTN=document.getElementById("next-btn");function updateArrows(){var scrollLeft=myElement.scrollLeft;var maxScroll=myElement.scrollWidth-myElement.clientWidth;var tolerance=8;var atStart=scrollLeft<=tolerance;var atEnd=(maxScroll-scrollLeft)<=tolerance;if(prevBTN)prevBTN.style.opacity=atStart?"0":"1";if(nextBTN)nextBTN.style.opacity=atEnd?"0":"1"}
updateArrows();function scrollHandler(e){clearTimeout(myElement.scrollTimeout);myElement.scrollTimeout=setTimeout(function(){var parentLeft=myElement.getBoundingClientRect().left;[].slice.call(myElement.children).forEach(function(ele){var diff=Math.abs(ele.getBoundingClientRect().left-parentLeft);if(diff<10){$('.activex').removeClass('activex');$("a[href='#"+ele.id+"']").addClass('activex')}});updateArrows()},120)}
myElement.addEventListener('scroll',scrollHandler);if(nextBTN){nextBTN.addEventListener("click",function(){myElement.scrollBy({left:gallery_item_size,behavior:"smooth"});setTimeout(updateArrows,350)})}
if(prevBTN){prevBTN.addEventListener("click",function(){myElement.scrollBy({left:-gallery_item_size,behavior:"smooth"});setTimeout(updateArrows,350)})}}
function setCookie(cname,cvalue,exdays){const d=new Date();d.setTime(d.getTime()+(exdays*24*60*60*1000));let expires="expires="+d.toUTCString();document.cookie=cname+"="+cvalue+";"+expires+";path=/"}
function deleteCookie(cname){const d=new Date();d.setTime(d.getTime()+(24*60*60*1000));let expires="expires="+d.toUTCString();document.cookie=cname+"=;"+expires+";path=/"}
function getCookie(cname){let name=cname+"=";let decodedCookie=decodeURIComponent(document.cookie);let ca=decodedCookie.split(';');for(let i=0;i<ca.length;i++){let c=ca[i];while(c.charAt(0)==' '){c=c.substring(1)}
if(c.indexOf(name)==0){return c.substring(name.length,c.length)}}
return""}
let cookie_consent=getCookie("user_cookie_consent");if(cookie_consent!=""){if(document.getElementById("CookieBanner"))
document.getElementById("CookieBanner").style.display="none"}else{if(document.getElementById("CookieBanner"))
document.getElementById("CookieBanner").style.display="block"}
window.acceptCookieConsent=function(){deleteCookie('user_cookie_consent');setCookie('user_cookie_consent',1,30);if(document.getElementById("CookieBanner"))
document.getElementById("CookieBanner").style.display="none"}})})
